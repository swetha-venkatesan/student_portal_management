-- =====================================================

-- Check total counts
SELECT 
    (SELECT COUNT(*) FROM students) AS total_students,
    (SELECT COUNT(*) FROM courses) AS total_courses,
    (SELECT COUNT(*) FROM enrollments) AS total_enrollments,
    (SELECT COUNT(*) FROM fees) AS total_fees,
    (SELECT COUNT(*) FROM attendance) AS total_attendance,
    (SELECT COUNT(*) FROM timetable) AS total_timetable,
    (SELECT COUNT(*) FROM users WHERE role='STUDENT') AS student_users;

-- View sample student with all details
SELECT 
    s.id,
    s.student_id,
    s.name,
    s.email,
    s.department,
    COUNT(DISTINCT e.course_id) AS enrolled_courses,
    SUM(f.amount) AS total_fees,
    SUM(f.paid_amount) AS paid_fees,
    COUNT(DISTINCT a.id) AS attendance_records
FROM students s
LEFT JOIN enrollments e ON s.id = e.student_id
LEFT JOIN fees f ON s.id = f.student_id
LEFT JOIN attendance a ON s.id = a.student_id
WHERE s.id = 1
GROUP BY s.id;

-- View all students with enrollment count
SELECT 
    s.id,
    s.student_id,
    s.name,
    s.department,
    COUNT(e.id) AS courses_enrolled
FROM students s
LEFT JOIN enrollments e ON s.id = e.student_id
GROUP BY s.id
ORDER BY s.id;


